APP_NAME="RHU Calasiao Patient Records"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-approved-host.example
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Defaults to database/database.sqlite; optionally set an absolute local file path.
# DB_DATABASE=C:/RHU/private/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
